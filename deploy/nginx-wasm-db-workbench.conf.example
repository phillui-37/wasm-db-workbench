# Example nginx site for https://wasm-db-workbench.kgy-production.xyz/
#
# Serve the workbench at the subdomain root (no path prefix).
# App defaults: VITE_BASE_PATH=/, BASE_PATH=/.
# Do not override Cross-Origin-* headers — the app sets COOP/COEP for WASM.
#
# After a new image is published, pull and recreate the container on the VPS:
#   pnpm podman:pull-up
# The running container must serve index.html with /assets/... not /wasm-db-workbench/assets/...

server {
  listen 443 ssl;
  server_name wasm-db-workbench.kgy-production.xyz;

  # ssl_certificate / ssl_certificate_key — certbot or your TLS setup

  client_max_body_size 256m;
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_read_timeout 300s;

  # Old image HTML still requests /wasm-db-workbench/assets/* and /api/*.
  # Strip the leftover prefix so those URLs hit /assets and /api on the app.
  location = /wasm-db-workbench {
    return 301 /;
  }
  location /wasm-db-workbench/ {
    proxy_pass http://127.0.0.1:8080/;
  }

  location / {
    proxy_pass http://127.0.0.1:8080;
  }
}
