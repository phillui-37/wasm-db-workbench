{
  "name": "wasm-db-browser-panel",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Phil Lui <phillui37@gmail.com>",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "pnpm --filter @workbench/backend --filter @workbench/frontend --parallel dev",
    "dev:backend": "pnpm --filter @workbench/backend dev",
    "dev:frontend": "pnpm --filter @workbench/frontend dev",
    "build": "pnpm --filter @workbench/frontend build",
    "start": "pnpm --filter @workbench/backend start",
    "test": "vitest run",
    "test:watch": "vitest",
    "docker:build": "bash deploy/docker-build.sh",
    "docker:build:prebuilt": "bash deploy/docker-build-prebuilt.sh",
    "docker:up": "bash deploy/docker-up.sh",
    "docker:up:prebuilt": "bash deploy/docker-up-prebuilt.sh",
    "docker:save": "bash deploy/docker-save.sh",
    "docker:load-up": "bash deploy/docker-load-up.sh",
    "docker:push": "bash deploy/docker-push.sh",
    "docker:pull-up": "bash deploy/docker-pull-up.sh",
    "podman:build": "bash deploy/podman-build.sh",
    "podman:build:prebuilt": "bash deploy/podman-build-prebuilt.sh",
    "podman:up": "bash deploy/podman-up.sh",
    "podman:up:prebuilt": "bash deploy/podman-up-prebuilt.sh",
    "podman:save": "bash deploy/podman-save.sh",
    "podman:load-up": "bash deploy/podman-load-up.sh",
    "podman:push": "bash deploy/podman-push.sh",
    "podman:pull-up": "bash deploy/podman-pull-up.sh"
  },
  "devDependencies": {
    "@effect/vitest": "^0.30.0",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
